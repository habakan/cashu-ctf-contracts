{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/habakan/cashu-ctf-contracts/schema.json",
  "title": "cashu-ctf-contracts v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "oracles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pubkeys"],
        "properties": {
          "pubkeys": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/pubkey" } },
          "threshold": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "parties": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "events": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["oracle", "title", "outcomes", "maturity"],
        "properties": {
          "oracle": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "outcomes": { "type": "array", "minItems": 2, "items": { "$ref": "#/definitions/outcome" } },
          "labels": { "type": "object", "additionalProperties": { "type": "string" } },
          "maturity": { "type": "string" },
          "every": { "type": "string", "pattern": "^(day|week|(RRULE:)?FREQ=[A-Z]+(;[A-Z]+=[^;]+)*)$" }
        }
      }
    },
    "markets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event", "mint", "unit"],
        "properties": {
          "event": { "type": "string" },
          "mint": { "type": "string", "pattern": "^https?://" },
          "unit": { "enum": ["sat", "msat"] },
          "outcome_collections": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,191}(\\|[A-Za-z0-9_-]{1,191})*$" }
          }
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event", "payout", "settle"],
        "properties": {
          "event": { "type": "string" },
          "payout": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": { "$ref": "#/definitions/amount" }
            }
          },
          "max_per_day": { "$ref": "#/definitions/amount" },
          "settle": { "enum": ["lightning", "cashu-ctf"] }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "per_day": { "$ref": "#/definitions/amount" } }
    }
  },
  "definitions": {
    "amount": { "type": "string", "pattern": "^[1-9][0-9]* (sat|msat|jpy)$" },
    "outcome": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,191}$" },
    "pubkey": { "type": "string", "pattern": "^(npub1[02-9ac-hj-np-z]{58}|[0-9a-f]{64})$" }
  }
}
