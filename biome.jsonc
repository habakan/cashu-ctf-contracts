{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  // markdown と YAML は、文書の改行を手で決めていることと lockfile が生成物であることから対象にしない
  "files": { "ignoreUnknown": false, "includes": ["**", "!**/*.md", "!pnpm-lock.yaml"] },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": { "level": "error", "options": { "allow": ["log", "warn", "error"] } }
      }
    }
  },
  "javascript": { "formatter": { "quoteStyle": "double" } },
  "overrides": [
    {
      "includes": ["**/test/**"],
      "linter": {
        "rules": {
          // テストでは非 null 断定を許す。固定値を入れた前提で書くほうが読みやすいため
          "style": { "noNonNullAssertion": "off" }
        }
      }
    }
  ],
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } }
}
